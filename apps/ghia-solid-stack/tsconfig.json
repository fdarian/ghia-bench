{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@ghia/solid",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun",
      "vite/client"
    ],
    "paths": {
      "@ghia/solid/jsx-runtime": [
        "../../vendor/ghia/packages/solid/dist/jsx-runtime.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "build.ts",
    "vite.config.mts"
  ]
}